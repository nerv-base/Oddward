<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../internal/branding/icon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestPatch</RollForward>
    <AssemblyName>Oddward.LoginUi</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../internal/branding/icon.ico" Link="Branding/icon.ico" />
    <Resource Include="../../internal/branding/symbol.png" Link="Branding/symbol.png" />
    <Compile Include="Program.cs" />
    <Compile Include="Protocol.cs" />
    <Compile Include="LoginWindow.cs" />
    <Compile Include="GameOverlay.cs" />
    <Compile Include="LoginViewController.cs" />
    <Compile Include="Presentation/LoginSurface.cs" />
    <Compile Include="Presentation/LoginVisuals.cs" />
  </ItemGroup>
  <Target Name="CopyRuntimeLicenseNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <Error Condition="!Exists('%(ResolvedRuntimePack.PackageDirectory)/LICENSE') and !Exists('%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT')"
           Text="Runtime license is missing for %(ResolvedRuntimePack.NuGetPackageId)." />
    <ItemGroup>
      <_RuntimeLicenseNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE*;%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*;%(ResolvedRuntimePack.PackageDirectory)/ThirdPartyNotices*">
        <PackageId>%(ResolvedRuntimePack.NuGetPackageId)</PackageId>
      </_RuntimeLicenseNotice>
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeLicenseNotice)"
          DestinationFiles="@(_RuntimeLicenseNotice->'$(PublishDir)licenses/%(PackageId)/%(Filename)%(Extension)')" />
  </Target>
</Project>
